{
 "name": "aswaq-badr",
 "version": "2.0.0",
 "description": "Aswaq Badr Supermarket",
 "main": "main.js",
 "scripts": {
  "prep": "node scripts/prep.js",
  "start": "npm run prep && electron .",
  "build-exe": "npm run prep && electron-builder --win nsis --publish never"
 },
 "build": {
  "appId": "com.aswaqbadr.pos",
  "productName": "Aswaq Badr",
  "files": [
   "main.js",
   "preload.js",
   "app/**"
  ],
  "win": {
   "target": "nsis",
   "icon": "icon.png"
  }
 },
 "dependencies": {
  "xlsx": "0.18.5",
  "html5-qrcode": "2.3.8"
 },
 "devDependencies": {
  "electron": "^30.0.0",
  "electron-builder": "^24.13.3",
  "@capacitor/cli": "^6.1.0",
  "@capacitor/core": "^6.1.0",
  "@capacitor/android": "^6.1.0",
  "@capacitor/filesystem": "^6.0.0",
  "@capacitor/share": "^6.0.0",
  "@capacitor/assets": "^3.0.5"
 }
}